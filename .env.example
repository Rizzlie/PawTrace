# Optional: Docker Compose reads .env automatically.
APP_PORT=8080
API_HOST=127.0.0.1
API_PORT=3000
# NestJS ConfigModule loads this file for Node development; shell variables win.
# Start the cache with: docker compose up -d --wait redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
# Persistent host directory for originals and asset metadata; back it up with case JSON.
ASSET_DIRECTORY=./data/assets
# Public browser token (pk.*), not a secret/admin token. OSM works without it.
MAPBOX_PUBLIC_TOKEN=
# Optional source overrides: provide each URL together with its HTML attribution.
# Keep {z}/{x}/{y}; satellite URLs may include {accessToken} for the public token.
# OSM-compatible sources use 256 px tiles; satellite sources use 512 px tiles.
# Empty pairs retain the default OSM and Mapbox satellite-streets-v12 sources.
OSM_TILE_URL=
OSM_ATTRIBUTION=
SATELLITE_TILE_URL=
SATELLITE_ATTRIBUTION=
# Nominatim-compatible server search endpoint. Restart the API after changing.
ADDRESS_SEARCH_URL=https://nominatim.openstreetmap.org/search
ADDRESS_SEARCH_USER_AGENT=PawTrace/1.0 (+https://github.com/Rizzlie/PawTrace)
ADDRESS_SEARCH_ATTRIBUTION=© OpenStreetMap contributors
ADDRESS_SEARCH_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
